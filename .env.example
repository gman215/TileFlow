# Copy to .env.local (gitignored) and fill in. Never commit a real key.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Model ids are env-overridable so a model change is a deployment setting,
# not a code change. Defaults verified against ai.google.dev.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.1-flash-lite
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite

# On the vision default: gemini-3.1-flash-lite read 002's ground-truth plan
# bit-exact 5/5, rejected a non-plan image and ignored an injected instruction,
# at roughly a tenth the cost of gemini-3.8-flash (~$0.0007 vs ~$0.0057/call).
# Newer is not better here — gemini-3.5-flash-lite failed the same plan by
# returning raw pixel coordinates. Set this to gemini-3.8-flash to revert.


# Spend protection for a public demo on a personal key (Constitution VII).
AI_DAILY_CALL_BUDGET=500
AI_RATE_LIMIT_PER_MIN=10

# How long to stop calling the provider after it refuses for a reason that will
# not clear immediately (429 quota/billing, 403 restricted key). During the
# window the routes serve canned demo content and /api/ai/health reports
# demoMode. 0 disables the memory, so every request retries.
AI_UPSTREAM_COOLDOWN_MIN=15
