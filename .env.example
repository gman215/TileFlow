# Copy to .env.local (gitignored) and fill in. Never commit a real key.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Model ids are env-overridable so a model change is a deployment setting,
# not a code change. Defaults verified against ai.google.dev.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.8-flash
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite

# Spend protection for a public demo on a personal key (Constitution VII).
AI_DAILY_CALL_BUDGET=500
AI_RATE_LIMIT_PER_MIN=10
