// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room       Room?
  tileConfig TileConfig?
  layouts    SavedLayout[]
}

model Room {
  id        String @id @default(cuid())
  projectId String @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Width in mm
  width  Float
  /// Height in mm
  height Float
  /// Display unit preference
  unit   String @default("mm")
}

model TileConfig {
  id        String @id @default(cuid())
  projectId String @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Tile width in mm
  width  Float
  /// Tile height in mm
  height Float
  /// Grout gap in mm
  grout  Float  @default(3.0)
  /// Pattern type: grid, offset-1/2, offset-1/3, herringbone, diagonal-45
  pattern String @default("grid")

  /// Optimization weight α (min cut area preference)
  alpha Float @default(0.7)
  /// Optimization weight β (waste penalty)
  beta  Float @default(0.3)
}

model SavedLayout {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Serialized LayoutResult JSON
  layoutData  Json
  /// Snapshot of config at time of save
  configData  Json
  /// Score at time of save
  score       Float
  /// Label for this layout snapshot
  label       String?
}
